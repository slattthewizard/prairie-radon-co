import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Radon Mitigation Winnipeg, Manitoba & SK | Prairie Radon Co"
  description="Radon mitigation in Winnipeg and across Manitoba and Saskatchewan. Start with a long-term test, then a written quote from a certified professional. Call now."
  canonical="https://prairieradonco.ca/"
>
<Fragment slot="head">
<script type="application/ld+json">{"@type": ["ProfessionalService", "LocalBusiness"], "@id": "https://prairieradonco.ca/#organization", "name": "Prairie Radon Co", "url": "https://prairieradonco.ca", "logo": {"@type": "ImageObject", "url": "https://prairieradonco.ca/images/og-image.webp"}, "priceRange": "$$", "telephone": "(204) 555-0173", "email": "info@prairieradonco.ca", "address": {"@type": "PostalAddress", "addressLocality": "Winnipeg", "addressRegion": "MB", "addressCountry": "CA"}, "geo": {"@type": "GeoCoordinates", "latitude": 49.8951, "longitude": -97.1384}, "areaServed": [{"@type": "City", "name": "Winnipeg", "addressRegion": "MB"}, {"@type": "City", "name": "Winnipeg", "addressRegion": "MB"}, {"@type": "City", "name": "Regina", "addressRegion": "SK"}, {"@type": "City", "name": "Saskatoon", "addressRegion": "SK"}, {"@type": "City", "name": "Brandon", "addressRegion": "MB"}, {"@type": "City", "name": "Moose Jaw", "addressRegion": "SK"}, {"@type": "City", "name": "Prince Albert", "addressRegion": "SK"}], "@context": "https://schema.org", "description": "Radon mitigation in Winnipeg and across Manitoba and Saskatchewan. Start with a long-term test, then a written quote from a certified professional. Call now.", "image": "https://prairieradonco.ca/images/og-image.webp", "hasOfferCatalog": {"@type": "OfferCatalog", "name": "Radon Services", "itemListElement": [{"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Radon Mitigation Systems"}}, {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Radon Testing"}}, {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Radon Testing for Home Sales"}}, {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Radon Fan Replacement"}}]}}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "WebSite", "@id": "https://prairieradonco.ca/#website", "url": "https://prairieradonco.ca", "name": "Prairie Radon Co", "publisher": {"@id": "https://prairieradonco.ca/#organization"}}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Do I really need to test before I get a quote?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Health Canada's guideline is based on the average level over time, so it recommends a long-term test of at least 91 days in the heating season. Short tests and digital monitors are good for screening, but they can't tell you whether a system is worth paying for."}}, {"@type": "Question", "name": "How is a mitigation job priced and scoped?", "acceptedAnswer": {"@type": "Answer", "text": "A certified mitigation professional visits the house and looks at the slab, any sump pit or crawl space, and where the pipe and fan can run and vent. Winnipeg installers advertise systems from about $1,500 to $3,000, and a Regina installer quotes $2,500 to $3,500, adding that crawl spaces or multiple suction points can cost much more. Your own price comes only from the written quote after that visit."}}, {"@type": "Question", "name": "How long does it take to get someone out, and how long does the work take?", "acceptedAnswer": {"@type": "Answer", "text": "We don't publish a set response time, because the professionals are independent and their calendars vary; they'll give you a date when you call. The test itself takes at least 91 days, and Health Canada says a system can usually be installed in less than a day. One Winnipeg installer, Radon Manitoba, adds 20% to its prices for off-season work between November 30 and May 20, so ask about timing when you get your quote."}}, {"@type": "Question", "name": "Is 200 Bq/m3 a legal limit?", "acceptedAnswer": {"@type": "Answer", "text": "No. Bq/m3 means becquerels per cubic metre, and 200 Bq/m3 is Health Canada's guideline (about 5.4 pCi/L, the US unit). No law in Manitoba or Saskatchewan requires homeowners to test or mitigate. Above 200, Health Canada recommends fixing it within a year, and it also says no level is considered risk free."}}, {"@type": "Question", "name": "Is there any help paying for a system?", "acceptedAnswer": {"@type": "Answer", "text": "The Canadian Lung Association's Lungs Matter program offers up to $1,500 for lower- and moderate-income households, and it needs a C-NRPP long-term test over 200 and a C-NRPP quote before work starts. In Manitoba, the Manitoba Hydro Home Energy Efficiency Loan covers radon mitigation up to $5,000 over 5 years at 6.2% (O.A.C.). In Saskatchewan, Lung Saskatchewan says radon mitigation counts as an eligible expense for the Home Renovation Tax Credit; confirm that with CRA before you count on it."}}, {"@type": "Question", "name": "Is Prairie Radon Co a certified radon company?", "acceptedAnswer": {"@type": "Answer", "text": "No. We're an advertising service that connects homeowners with independent C-NRPP certified professionals, and we don't test or install anything ourselves. Certification in Canada is voluntary and belongs to the individual professional, so check their name in C-NRPP's online directory before you hire them."}}]}</script>
<style is:global>
  .rich p { font-size: 16px; line-height: 1.8; color: #555; margin: 0 0 16px; }
